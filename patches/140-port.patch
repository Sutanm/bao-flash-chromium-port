+int32_t UDPSocketResource::RecvFrom(char* buffer,
+                                    int32_t num_bytes,
+                                    PP_Resource* addr,
+                                    scoped_refptr<TrackedCallback> callback) {
+  return RecvFromImpl(buffer, num_bytes, addr, callback);
+}
