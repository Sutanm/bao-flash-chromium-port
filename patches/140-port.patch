+  Es9_8 = Es9_1 + Es9_2,
+  /* OK EnumItem(Es9_9) */
+  Es9_9 = Es9_1 - Es9_2,
+  /* OK EnumItem(Es9_10) */
+  Es9_10 = Es9_1 * Es9_2,
+  /* OK EnumItem(Es9_11) */
+  Es9_11 = Es9_1 / Es9_2,
+  /* OK EnumItem(Es9_12) */
+  Es9_12 = -Es9_1,
+  /* OK EnumItem(Es9_13) */
+  Es9_13 = ~Es9_1,
+  /* OK EnumItem(Es9_14) */
