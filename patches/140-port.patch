+std::string StringFromPPVar(const PP_Var& var) {
+  scoped_refptr<ppapi::StringVar> name_stringvar =
+      ppapi::StringVar::FromPPVar(var);
+  if (!name_stringvar.get())
+    return std::string();
+  return name_stringvar->value();
+}
