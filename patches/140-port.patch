+                                  int32_t num_bytes,
+                                  PP_Resource addr,
+                                  scoped_refptr<TrackedCallback> callback) {
+  EnterNetAddressNoLock enter(addr, true);
+  if (enter.failed())
+    return PP_ERROR_BADARGUMENT;
+
+  return SendToImpl(buffer, num_bytes, &enter.object()->GetNetAddressPrivate(),
+                    callback);
+}
