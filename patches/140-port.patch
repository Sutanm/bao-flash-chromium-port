diff --git a/ppapi/c/ppb_view.h b/ppapi/c/ppb_view.h
new file mode 100644
index 0000000000000..27a70193a4521
--- /dev/null
+++ b/ppapi/c/ppb_view.h
@@ -0,0 +1,243 @@
+/* Copyright 2012 The Chromium Authors
