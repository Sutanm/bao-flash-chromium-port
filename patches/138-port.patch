+class LocalTimeZoneOffsetCache
+    : public base::LRUCache<PP_Time, LocalTimeZoneOffsetEntry> {
+ public:
+  LocalTimeZoneOffsetCache()
+      : base::LRUCache<PP_Time, LocalTimeZoneOffsetEntry>(kCacheSize) {}
+ private:
