+PP_Var GetCommandLineArgs(PP_Module /* pp_module */) {
+  // There's no instance so we have to reach into the globals without thunking.
+  ProxyAutoLock lock;
+  // Chromium 138 removed PpapiGlobals::GetCmdLine(); read the plugin switch
+  // directly instead (--ppapi-flash-args is still forwarded to the plugin
+  // process by our browser-side code).
+  std::string flash_args;
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  if (cmd->HasSwitch("ppapi-flash-args"))
+    flash_args = cmd->GetSwitchValueASCII("ppapi-flash-args");
+  return StringVar::StringToPPVar(flash_args);
+}
