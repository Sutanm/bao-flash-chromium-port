+
+/* From ppb_audio_config.idl modified Mon Oct 23 15:24:19 2017. */
+
+#ifndef PPAPI_C_PPB_AUDIO_CONFIG_H_
+#define PPAPI_C_PPB_AUDIO_CONFIG_H_
+
+#include "ppapi/c/pp_bool.h"
