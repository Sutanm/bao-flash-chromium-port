+#if BUILDFLAG(IS_MAC)
+bool PpapiPluginSandboxedProcessLauncherDelegate::DisclaimResponsibility() {
+  return true;
+}
+bool PpapiPluginSandboxedProcessLauncherDelegate::
+    EnableCpuSecurityMitigations() {
+  return true;
+}
+#endif
