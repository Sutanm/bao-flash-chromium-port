+#ifndef PPAPI_PROXY_UDP_SOCKET_FILTER_H_
+#define PPAPI_PROXY_UDP_SOCKET_FILTER_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <memory>
