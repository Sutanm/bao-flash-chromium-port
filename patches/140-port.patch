+void Buffer_Dev::Init() {
+  if (get_interface<PPB_Buffer_Dev>()->Describe(pp_resource(), &size_)) {
+    data_ = get_interface<PPB_Buffer_Dev>()->Map(pp_resource());
+    if (data_)
+      return;
+  }
+
+  Clear();
+  data_ = NULL;
+  size_ = 0;
+}
