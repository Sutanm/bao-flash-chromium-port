+ * @}
+ */
+
+/**
+ * @addtogroup Interfaces
+ * @{
+ */
+/**
+ * The <code>PPB_FileRef</code> struct represents a "weak pointer" to a file in
+ * a file system.  This struct contains a <code>PP_FileSystemType</code>
+ * identifier and a file path string.
