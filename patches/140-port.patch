+
+  core_interface_->ReleaseResource(ws);
+
+  for (int i = 0; kInvalidURLs[i]; ++i) {
+    int32_t result;
+    ws = Connect(kInvalidURLs[i], &result, std::string());
+    ASSERT_TRUE(ws);
+    ASSERT_EQ(PP_ERROR_BADARGUMENT, result);
+
+    core_interface_->ReleaseResource(ws);
+  }
