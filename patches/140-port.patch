+struct Graphics3DContextAttribs {
+  gfx::Size offscreen_framebuffer_size;
+  // -1 if invalid or unspecified.
+  int32_t alpha_size = -1;
+  int32_t depth_size = -1;
+  int32_t stencil_size = -1;
