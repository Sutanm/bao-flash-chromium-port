+/**
+ * The <code>PPB_MouseInputEvent</code> interface contains pointers to several
+ * functions related to mouse input events.
+ */
+[macro="PPB_MOUSE_INPUT_EVENT_INTERFACE"]
+interface PPB_MouseInputEvent {
