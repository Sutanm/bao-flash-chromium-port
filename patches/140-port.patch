+ */
+/**
+ * The <code>PP_Time</code> type represents the "wall clock time" according
+ * to the browser and is defined as the number of seconds since the Epoch
+ * (00:00:00 UTC, January 1, 1970).
+ */
+typedef double PP_Time;
