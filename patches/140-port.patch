+        PpapiGlobals::PerThreadForTest(), ipc_task_runner);
+    PpapiGlobals::SetPpapiGlobalsOnThreadForTest(GetGlobals());
+  } else {
+    plugin_globals_ = std::make_unique<PluginGlobals>(ipc_task_runner);
+  }
