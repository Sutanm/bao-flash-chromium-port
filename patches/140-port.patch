+  ASSERT_TRUE(socket.GetRemoteAddress(&remote_address));
+
+  ASSERT_TRUE(NetAddressPrivate::AreHostsEqual(local_address, local_address));
+  ASSERT_TRUE(NetAddressPrivate::AreHostsEqual(local_address, remote_address));
+
+  socket.Disconnect();
+  PASS();
+}
