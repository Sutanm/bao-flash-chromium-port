+    PP_Resource ws = Connect(kInvalidURLs[i], &result, std::string());
+    ASSERT_TRUE(ws);
+    PP_Var url = websocket_interface_->GetURL(ws);
+    ASSERT_TRUE(AreEqualWithString(url, kInvalidURLs[i]));
+    ASSERT_EQ(PP_ERROR_BADARGUMENT, result);
