+VideoDecoderResource::ShmBuffer::ShmBuffer(
+    base::UnsafeSharedMemoryRegion region,
+    uint32_t shm_id)
+    : region(std::move(region)), shm_id(shm_id) {
+  mapping = this->region.Map();
+  if (mapping.IsValid())
+    addr = mapping.memory();
+}
