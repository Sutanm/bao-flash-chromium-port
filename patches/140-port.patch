+  if (!has_interface<PPB_InputEvent_1_0>())
+    return;
+  if (get_interface<PPB_InputEvent_1_0>()->IsInputEvent(input_event_resource)) {
+    Module::Get()->core()->AddRefResource(input_event_resource);
+    PassRefFromConstructor(input_event_resource);
