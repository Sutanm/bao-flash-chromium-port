+        pp_resource(), frame.pp_resource());
+  } else if (has_interface<PPB_MediaStreamVideoTrack_0_1>()) {
+    return get_interface<PPB_MediaStreamVideoTrack_0_1>()->RecycleFrame(
+        pp_resource(), frame.pp_resource());
