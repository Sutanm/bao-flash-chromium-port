+PepperUDPSocketMessageFilter::~PepperUDPSocketMessageFilter() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  DCHECK(closed_);
+  DCHECK(!socket_);
+  DCHECK(!receiver_.is_bound());
+  --g_num_udp_filter_instances;
