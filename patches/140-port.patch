+  PP_MAKEDIRECTORYFLAG_WITH_ANCESTORS = 1 << 0,
+  /**
+   * Requests that the PPB_FileRef.MakeDirectory() call fails if the directory
+   * already exists.
+   */
+  PP_MAKEDIRECTORYFLAG_EXCLUSIVE = 1 << 1
+} PP_MakeDirectoryFlags;
