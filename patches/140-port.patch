+
+
+/**
+ * @addtogroup Enums
+ * @{
+ */
+/**
+ * Type of a network interface.
+ */
+typedef enum {
+  /**
+   * Type of the network interface is not known.
+   */
+  PP_NETWORKLIST_TYPE_UNKNOWN = 0,
+  /**
+   * Wired Ethernet network.
+   */
