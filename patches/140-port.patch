+        pp_resource(), callback.output(), callback.pp_completion_callback());
+  } else if (has_interface<PPB_MediaStreamVideoTrack_0_1>()) {
+    return get_interface<PPB_MediaStreamVideoTrack_0_1>()->GetFrame(
