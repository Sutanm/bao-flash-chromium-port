+// A fake version of V8ObjectVar for testing.
+class V8ObjectVar : public ppapi::Var {
+ public:
+  V8ObjectVar(const PPP_Class_Deprecated* ppp_class, void* ppp_class_data)
+      : ppp_class_(ppp_class), ppp_class_data_(ppp_class_data) {}
