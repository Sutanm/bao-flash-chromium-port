+  PP_Resource ws = websocket_interface_->Create(instance_->pp_instance());
+  ASSERT_TRUE(ws);
+
+  result = websocket_interface_->IsWebSocket(ws);
+  ASSERT_TRUE(result);
+
+  core_interface_->ReleaseResource(ws);
+
+  PASS();
