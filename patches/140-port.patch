+void PPB_Instance_Proxy::UnregisterMessageHandler(PP_Instance instance) {
+  InstanceData* data =
+      static_cast<PluginDispatcher*>(dispatcher())->GetInstanceData(instance);
+  if (!data)
+    return;
+  data->message_handler.reset();
