+  PP_Resource ws = Connect(GetFullURL(kEchoServerURL), &result, std::string());
+  ASSERT_TRUE(ws);
+  ASSERT_EQ(PP_OK, result);
+  PP_Var extensions = websocket_interface_->GetExtensions(ws);
+  ASSERT_TRUE(AreEqualWithString(extensions, std::string()));
