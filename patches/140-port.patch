+    SyncCall<PpapiPluginMsg_BrowserFontSingleton_GetFontFamiliesReply>(
+        BROWSER, PpapiHostMsg_BrowserFontSingleton_GetFontFamilies(),
+        &families_);
+  }
+  return StringVar::StringToPPVar(families_);
+}
