+bool RendererPpapiHostImpl::IsValidInstance(PP_Instance instance) {
+  return !!GetAndValidateInstance(instance);
+}
+
+PepperPluginInstance* RendererPpapiHostImpl::GetPluginInstance(
+    PP_Instance instance) {
+  return GetAndValidateInstance(instance);
+}
