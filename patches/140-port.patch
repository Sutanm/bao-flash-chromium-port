+int32_t UDPSocket::SetOption(PP_UDPSocket_Option name,
+                             const Var& value,
+                             const CompletionCallback& callback) {
+  if (has_interface<PPB_UDPSocket_1_2>()) {
+    return get_interface<PPB_UDPSocket_1_2>()->SetOption(
