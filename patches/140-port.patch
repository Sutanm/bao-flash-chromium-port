+    int32_t end,
+    gpu::CommandBuffer::State* state,
+    bool* success) {
+  EnterHostFromHostResource<PPB_Graphics3D_API> enter(context);
+  if (enter.failed()) {
+    *success = false;
+    return;
+  }
+  *state = enter.object()->WaitForTokenInRange(start, end);
+  *success = true;
+}
