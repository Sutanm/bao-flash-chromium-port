+
+uint64_t PpapiCommandBufferProxy::GenerateFenceSyncRelease() {
+  return next_fence_sync_release_++;
+}
+
+bool PpapiCommandBufferProxy::IsFenceSyncReleased(uint64_t release) {
+  NOTREACHED();
+}
